# =============================================================================
# Remote Workstation - Example Terraform Variables
# =============================================================================
#
# Copy to terraform.tfvars and fill in:
#   cp terraform.tfvars.example terraform.tfvars
#

region     = "ap-south-1"
aws_profile = "personal"

project_name = "personal-workstation"
environment  = "devcontainer"

# ECS host details (get from AWS console or CLI)
subnet_id          = "subnet-03719b90803e3525d"
security_group_id  = "sg-0cccdba2a855c16d3"
availability_zone  = "ap-south-1a"
