# Workstation secrets
# 1. cp this to secrets.yaml, fill in real values
# 2. sops --encrypt secrets.yaml > secrets.yaml.sops
# 3. rm secrets.yaml

hermes_env: |
  DEEPSEEK_API_KEY=sk-your-deepseek-key
  TELEGRAM_BOT_TOKEN=your-bot-token-from-botfather
  TELEGRAM_ALLOWED_USERS=1536460301

aws_credentials: |
  [personal]
  aws_access_key_id=YOUR_ACCESS_KEY
  aws_secret_access_key=YOUR_SECRET_KEY
